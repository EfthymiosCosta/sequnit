local_cusum <- function(env = parent.frame()) {
  dir <- withr::local_tempdir(.local_envir = env)
  withr::local_options(cusum.dir = dir, cusum.group = NULL, cusum.fail_on_signal = TRUE,
                       .local_envir = env)
  design <- list(alpha = 0.05, power = 0.2, U0 = 1e5, cbar0max = 1.1, amax = 10L,
                 p_leave = 0.01, n_bins = 151L, delta = .delta(0.05, 0.2),
                 gap = 4.352712345678, h = 21.33339871234, H = 21.33339871234 + 4.352712345678,
                 v = 4.91230012345, u0 = 100123.456789, u1 = 33.123456789,
                 cbar0 = 1.0999876543, h_lo = 18.1, h_up = 25.2)
  design_dir <- file.path(dir, "designs")
  dir.create(design_dir)
  key <- .design_key(0.05, 0.2, 1e5, 1.1, 10L, 0.01, 151L)
  jsonlite::write_json(design, file.path(design_dir, paste0(key, ".json")),
                       auto_unbox = TRUE, digits = NA)
  dir
}
